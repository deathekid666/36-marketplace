# Core
DATABASE_URL="postgresql://USER:PASSWORD@HOST/marketplace36?sslmode=require"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Sessions
SESSION_COOKIE_NAME="36_session"
SESSION_TTL_DAYS="30"

# Payments
PAYMENT_PROVIDER="MANUAL"
PAYMENT_WEBHOOK_SECRET="replace-with-a-long-random-secret"

# Email notifications (optional until launch)
RESEND_API_KEY=""
NOTIFICATION_FROM_EMAIL="36 <notifications@example.com>"

# WhatsApp notifications (optional)
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_TEMPLATE_NAME=""
WHATSAPP_TEMPLATE_LANG="en_US"
WHATSAPP_GRAPH_VERSION="v23.0"

# Maps / geocoding (optional)
MAPBOX_ACCESS_TOKEN=""

# File uploads (Cloudinary unsigned upload preset)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_UPLOAD_PRESET=""

# Scheduled reminders
CRON_SECRET="replace-with-a-long-random-secret"

# Growth
REFERRAL_REWARD_AMOUNT="0"
REFERRAL_REWARD_CURRENCY="USD"
# Backward-compatible legacy fallback only:
REFERRAL_REWARD_MAD=""


# Discovery provider (optional override; D6 defaults to a public Overpass instance)
OVERPASS_API_URL="https://overpass.private.coffee/api/interpreter"
